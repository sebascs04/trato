# Not loaded automatically: export these in the server shell or use a local loader.
# Browser must never receive service-role or Postgres credentials.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Current runnable graph is a LOCAL SQLite demo, not a Supabase connection.
# Checkpoints and uploaded business records will migrate to Postgres/Storage later.
# TRATO_PYTHON=/absolute/path/to/.venv/bin/python
# TRATO_LOCAL_DATA=/absolute/path/to/private/local-data
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# Trato Copilot local runtime
TRATO_MEETING_SECRET=replace-local-secret
TRATO_MEETING_HOST=127.0.0.1
TRATO_MEETING_PORT=8100
TRATO_MEETING_BACKEND_URL=http://127.0.0.1:8100
TRATO_MEETING_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRATO_GEMINI_API_KEY=
TRATO_GEMINI_MODEL=gemini-2.0-flash-live-001
TRATO_GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live
TRATO_GEMINI_ANALYSIS_MODEL=gemini-3.8-flash
TRATO_GEMINI_PROJECT=
TRATO_GEMINI_LOCATION=us-central1

# Explicit local service toggles
TRATO_AI_WORKFLOWS_ENABLED=false
TRATO_REHEARSAL_ENABLED=false
TRATO_VECTOR_SEARCH_ENABLED=false
TRATO_FILE_PROCESSING_ENABLED=false
