# Compose 2.30+; private files are OUTSIDE Git and all image build contexts.
TRATO_PRIVATE_DIR=/opt/trato-private
# The VM's fixed PRIVATE IPv4, never 0.0.0.0 or its public address.
TRATO_API_BIND_IP=10.40.0.10

# Explicit mail mode. Set trato for the central sender; personal preserves the previous setup.
GMAIL_DELIVERY_MODE=personal
# Backend-verified Supabase UUID allowed to manage the central mailbox.
GMAIL_TRATO_ACCOUNT_OWNER=
GMAIL_TRATO_ACCOUNT_EMAIL=
