FROM node:22-bookworm-slim
WORKDIR /app
# Runtime packages only (ws for the meeting relay); the lockfile pins them.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY *.html *.css *.mjs *.js local-ports.json ./
COPY assets ./assets
COPY locales ./locales
COPY data ./data
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8080 TRATO_DEPLOYMENT_MODE=connected
USER node
EXPOSE 8080
CMD ["node", "server.mjs"]
