SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
FILE_PROCESSOR_URL=http://127.0.0.1:8101
FILE_PROCESSOR_TOKEN=
WEB_ORIGIN=http://localhost:5173
# Separate Google OAuth web client for explicit Gmail send authorization.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:5173/gmail-callback.html
# Generate a Fernet key locally; never expose it in browser code or Git.
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_VAULT_PATH=.local/gmail/vault.sqlite3

# Server only. Never expose through /config or frontend variables.
SUPABASE_SERVER_KEY=

# Cola y consumidor backend. Secretos sólo de servidor.
TRATO_REDIS_URL=
TRATO_WORKER_TOKEN=

# Sandbox únicamente. Credenciales del servidor; no completar en Git.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=

# Aura Free propio de Trato. Nunca poner credenciales en el frontend.
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Ensayos local: activación explícita tras validar modelo/fuentes. Sin proveedor alternativo.
TRATO_REHEARSAL_ENABLED=false

# Five approved guides are bundled in resources/rehearsal-sources.
# Run scripts/configure-rehearsal-sources.py --configure from the root to set
# this absolute path for your installation. Empty means unavailable.
# Never point this at private project document storage.
TRATO_REHEARSAL_SOURCE_MANIFEST=

# Real rehearsal feedback uses the dedicated worker and existing private Redis queue.
TRATO_REHEARSAL_EVALUATOR_ENABLED=false

# Explicit test model allowlist; must match API and worker.
TRATO_TEST_MODEL_IDS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.6-flash,gemini-3.7-flash,gemini-3.1-pro-preview,gemini-4-argon
TRATO_DEFAULT_MODEL=gemini-3.8-flash
# Confirmed tester emails; no frontend access control.
TRATO_MODEL_TESTER_EMAILS=

# Reputation and project-plan AI jobs, explicitly enabled.
TRATO_AI_WORKFLOWS_ENABLED=false
# Vector operations run in the file processor. Never put Weaviate keys here.
TRATO_VECTOR_SEARCH_ENABLED=false

# Purpose-aware file pipeline; requires migration 20261101212324 and running AI consumer.
# Explicit activation; failure never switches to index-only processing.
TRATO_FILE_PROCESSING_ENABLED=false
