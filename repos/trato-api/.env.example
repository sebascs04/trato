SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
FILE_PROCESSOR_URL=http://127.0.0.1:8101
FILE_PROCESSOR_TOKEN=
WEB_ORIGIN=http://localhost:5173
# Separate Google OAuth web client for explicit Gmail send authorization.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:5173/gmail-callback.html
# Generate a Fernet key locally; never expose it in browser code or Git.
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_VAULT_PATH=.local/gmail/vault.sqlite3

# Server only. Never expose through /config or frontend variables.
SUPABASE_SERVER_KEY=

# Cola y consumidor backend. Secretos sólo de servidor.
TRATO_REDIS_URL=
TRATO_WORKER_TOKEN=

# Sandbox únicamente. Credenciales del servidor; no completar en Git.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
