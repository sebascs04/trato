# Selección explícita; no hay modelo ni proveedor alternativo automático.
TRATO_MODEL_PROVIDER=
# Gemini: developer, vertex_express o vertex. Vacío desactiva la configuración.
TRATO_GEMINI_BACKEND=
TRATO_GEMINI_MODEL=
TRATO_GEMINI_API_KEY=
# Solo vertex con proyecto Cloud. No confundir con Gmail OAuth.
TRATO_GOOGLE_CLOUD_PROJECT=
TRATO_GOOGLE_CLOUD_LOCATION=
TRATO_GOOGLE_CREDENTIALS_FILE=
# Solo para el proveedor ollama elegido explícitamente.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Solo prueba explícita de ingesta. URL privada, nunca frontend.
TRATO_SIMULATION_REDIS_URL=

# Ingesta real, sin proveedor IA. No reutilizar Redis de QAMAQ.
TRATO_REDIS_URL=
TRATO_API_URL=http://127.0.0.1:8100
TRATO_WORKER_TOKEN=
FILE_PROCESSOR_URL=http://127.0.0.1:8101
FILE_PROCESSOR_TOKEN=
